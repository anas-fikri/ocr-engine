# HTTPS production di depan engine (docker-compose.prod.yml).
# PQE_TLS=internal          -> sertifikat dari CA internal Caddy (intranet / domain tidak publik).
# PQE_TLS=admin@domain.com  -> sertifikat Let's Encrypt otomatis (domain publik, port 80/443 terbuka dari internet).
{
	admin off
	# Browser tidak mengirim SNI saat dibuka lewat IP (https://10.3.3.243); tanpa ini handshake TLS gagal
	# (ERR_SSL_PROTOCOL_ERROR).
	default_sni {$PQE_DOMAIN}
}

{$PQE_DOMAIN} {
	tls {$PQE_TLS:internal}
	encode gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy engine:8000
}
