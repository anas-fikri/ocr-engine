# Salin ke .env lalu isi nilainya. JANGAN commit file .env.
# Penjelasan lengkap setiap variabel: docs/configuration.md

# ---------------------------------------------------------------------------
# SILO (S3-compatible). Nama variabel sama dengan aplikasi Laravel yang sudah ada.
# ---------------------------------------------------------------------------
AWS_ENDPOINT=https://s3.pcpexpress.com
# Host yang dipakai browser/pelanggan untuk membuka foto. Kosongkan jika sama dengan AWS_ENDPOINT.
AWS_PUBLIC_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=true
# Opsional: auto | path | virtual (menimpa AWS_USE_PATH_STYLE_ENDPOINT), dan versi signature (s3v4 | s3)
AWS_ADDRESSING_STYLE=
AWS_SIGNATURE_VERSION=s3v4
# Service account KHUSUS engine (jangan pakai akun admin/root SILO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket foto original milik aplikasi (engine hanya BACA)
AWS_BUCKET=ekas-pcptransport
AWS_URL=https://s3.pcpexpress.com/ekas-pcptransport

# Engine hanya MEMBACA SILO (tidak pernah menyimpan foto); penyimpanan dikerjakan aplikasi.
# Bucket di bawah hanya untuk data dari versi lama yang dulu menyimpan salinan di SILO. Instalasi baru tidak perlu membuatnya.
ENGINE_BUCKET_PROCESSED=photos-processed
ENGINE_BUCKET_THUMB=photos-thumb
ENGINE_BUCKET_UPLOAD=photos-upload
# true = buat bucket di atas dan AWS_BUCKET jika belum ada (hanya untuk SILO lokal / demo)
ENGINE_CREATE_BUCKETS=false

# Masa berlaku presigned URL (detik): Web UI 15 menit, pelanggan 7 hari
ENGINE_PRESIGN_TTL_UI=900
ENGINE_PRESIGN_TTL_CUSTOMER=604800

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Produksi: postgresql+psycopg://user:password@host:5432/pqe
# Lokal tanpa Postgres: sqlite:///./pqe.db
DATABASE_URL=sqlite:///./pqe.db

# ---------------------------------------------------------------------------
# API & keamanan
# ---------------------------------------------------------------------------
# URL publik engine (dipakai di link verifikasi pada PDF evidence)
PUBLIC_BASE_URL=http://localhost:8000
# Kunci admin awal. Dibuat otomatis saat start jika belum ada. Ganti dengan nilai acak panjang!
PQE_BOOTSTRAP_ADMIN_KEY=pqe_local_admin_change_me
# Kunci enkripsi untuk rahasia yang disimpan lewat Web UI (contoh secret key di halaman Koneksi SILO).
# Isi string acak panjang (contoh: openssl rand -hex 32). Jika diganti, secret di Web UI harus diisi ulang.
PQE_SECRET_KEY=
# production (bawaan) = pagar pengaman aktif: perintah demo ditolak. Engine tidak pernah menulis/menghapus di
# bucket aplikasi apa pun nilainya. docker-compose.yml lokal memakai development.
PQE_ENV=production
# Folder di PC/server tempat NAS di-mount (SMB/NFS), dipasang ke container sebagai /backup (halaman Backup NAS)
NAS_MOUNT=./backup
# Token yang dikirim SILO saat bucket notification (header Authorization)
PQE_S3_EVENT_TOKEN=local-event-token
PQE_DEFAULT_LANG=id
PQE_MAX_UPLOAD_MB=25
PQE_SYNC_TIMEOUT_MS=3000
# Origin web yang boleh memanggil API langsung dari browser (dipisah koma). Kosong = CORS mati.
PQE_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Worker & ingestor
# ---------------------------------------------------------------------------
PQE_TENANTS_DIR=config/tenants
PQE_WORKER_CONCURRENCY=2
PQE_WORKER_POLL_INTERVAL_SEC=1
PQE_JOB_MAX_ATTEMPTS=5
PQE_JOB_STALE_AFTER_SEC=600
PQE_RECONCILE_INTERVAL_SEC=86400
PQE_DUPLICATE_LOOKBACK_DAYS=90
PQE_METRICS_PORT=9100
PQE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Hanya untuk docker-compose.yml (SILO & Postgres lokal)
# ---------------------------------------------------------------------------
SILO_ROOT_USER=siloadmin
SILO_ROOT_PASSWORD=siloadmin-local-only
POSTGRES_PASSWORD=pqe-local-only
