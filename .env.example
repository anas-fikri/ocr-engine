# Salin ke .env lalu isi nilainya. JANGAN commit file .env.
# Format mengikuti konvensi aplikasi yang sudah ada (Laravel-style AWS_*).

# --- SILO (S3-compatible) ---
AWS_ENDPOINT=https://s3.pcpexpress.com
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket foto original milik aplikasi (engine hanya BACA)
AWS_BUCKET=ekas-pcptransport
AWS_URL=https://s3.pcpexpress.com/ekas-pcptransport

# Bucket milik engine (engine BACA + TULIS)
ENGINE_BUCKET_PROCESSED=photos-processed
ENGINE_BUCKET_THUMB=photos-thumb

# Masa berlaku presigned URL (detik)
ENGINE_PRESIGN_TTL_UI=900
ENGINE_PRESIGN_TTL_CUSTOMER=604800
